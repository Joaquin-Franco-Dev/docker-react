# Dependencies — installed inside the image by `npm ci`.
# Copying the host tree would shadow that layer with wrong-platform native binaries.
node_modules
/.pnp
.pnp.js

# Build output — regenerated by `npm run build` in the builder stage
dist
build

# Version control — full history, remotes, and any credential ever committed
.git
.github
.gitignore

# Environment files — never bake secrets into an image
.env
.env.*

# CI / container config — not needed at build time
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml
.travis.yml

# Editor / IDE / tooling
.idea
.vscode
.claude
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Logs and test output
coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs
README.md
*.md
